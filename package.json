{
  "name": "palpite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Palpite - adivinhe o secreto em turnos com os amigos, em 13 universos",
  "scripts": {
    "build:pokedex": "node scripts/build-pokedex.mjs",
    "build:bleach": "node scripts/build-bleach.mjs",
    "build:data": "npm run build:pokedex && npm run build:bleach && npm run build:naruto && npm run build:clash && npm run build:yugioh && npm run build:lol && npm run build:valorant && npm run build:rickmorty && npm run build:heroes && npm run build:potter && npm run build:lotr && npm run build:f1",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/smoke-test.mjs",
    "build:naruto": "node scripts/build-naruto.mjs",
    "build:clash": "node --max-old-space-size=2048 scripts/build-clash.mjs",
    "build:rickmorty": "node scripts/build-rickmorty.mjs",
    "build:valorant": "node scripts/build-valorant.mjs",
    "build:lol": "node scripts/build-lol.mjs",
    "build:heroes": "node scripts/build-heroes.mjs",
    "build:yugioh": "node --max-old-space-size=4096 scripts/build-yugioh.mjs",
    "build:lotr": "node scripts/build-lotr.mjs",
    "build:potter": "node scripts/build-potter.mjs",
    "build:f1": "node scripts/build-f1.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
